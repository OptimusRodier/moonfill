{
  "manifest_version": 3,
  "name": "Moonfill",
  "version": "2.1",
  "description": "Moonfill automates the Moonpull scan round trip (form, result in Chatter, scan fields) and includes Techfill, which fills the technical checklist of an Implementation record from a preset.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "alarms",
    "notifications",
    "tabGroups"
  ],
  "host_permissions": [
    "https://forms.office.com/*",
    "https://forms.cloud.microsoft/*",
    "https://awin.lightning.force.com/*",
    "https://zanox.sharepoint.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://forms.office.com/*",
        "https://forms.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://awin.lightning.force.com/*"
      ],
      "js": [
        "techfill-core.js",
        "salesforce.js",
        "techfill.js"
      ]
    }
  ]
}